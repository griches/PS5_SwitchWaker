+void finish_world_effects(const ClipRect& cameraScissor, bool image = false) {
+  // With no effects there is no world/HUD pass boundary to resolve. Check
+  // both live settings and an existing frame snapshot before draining queued GX.
+  if (!post_fx::any_enabled() &&
+      (!g_recorder.postEffectsTaken || !g_recorder.postEffects.any())) {
+    return;
+  }
+  gx::fifo::drain();
+  if (!g_recorder.active() || g_recorder.currentRenderPass == UINT32_MAX || g_recorder.inOffscreen ||
+      !g_recorder.postEffectsTaken || !g_recorder.postEffects.any()) {
+    return;
+  }
+  if (image ? !g_recorder.postEffects.image() : !g_recorder.postEffects.world()) return;
+  auto& frame = current_frame_packet();
+  auto& scene = current_render_passes()[g_recorder.currentRenderPass];
+  if (scene.colorAttachments[SceneColorAttachmentIndex].view.Get() != webgpu::g_frameBuffer.view.Get()) return;
+  // The game marks this after all world lists, before photo copies and HUD.
+  // Never infer this boundary from a full-size copy (reflections/blur also copy).
+  // The first perspective draw can be sky with a full-screen scissor. Use
+  // the game's camera bounds at the world boundary, including animated trim.
+  const auto clip = gx::map_logical_scissor(cameraScissor);
+  g_recorder.postEffects.worldScissor = {
+      uint32_t(std::max(0, clip.x)), uint32_t(std::max(0, clip.y)),
+      uint32_t(std::max(0, clip.width)), uint32_t(std::max(0, clip.height))};
+  g_recorder.postEffects.contentScale = g_contentScale;
+  scene.applyPostEffects = !image;
+  scene.applyImageEffects = image;
+  scene.discardable = false;
+  for (uint32_t i = 0; i < scene.colorAttachmentCount; ++i) {
+    scene.colorAttachments[i].storeOp = wgpu::StoreOp::Store;
+  }
+  if (scene.hasDepth) scene.depthStoreOp = wgpu::StoreOp::Store;
+  if (scene.hasStencil) scene.stencilStoreOp = wgpu::StoreOp::Store;
+  enqueue_pass(frame, g_recorder.currentRenderPass);
+  resume_efb_pass_loading(scene);
+}
