 namespace {
 Module Log("aurora::card");
 
+void allow_ftp_access(const std::filesystem::path& cardPath) {
+#if defined(__PROSPERO__)
+  // SDL creates directories as 0770. The console's FTP server may run under
+  // another user/group, so repair both the region and card directory on open.
+  for (const auto& path : {cardPath.parent_path(), cardPath}) {
+    if (!path.empty() && chmod(path.c_str(), 0777) != 0) {
+      Log.warn("Cannot make save directory '{}' FTP-accessible: {}", io::fs_path_to_string(path),
+               std::strerror(errno));
+    }
+  }
+#else
+  (void)cardPath;
+#endif
+}
+
