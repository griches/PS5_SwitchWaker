+// PlayStation 5: PS5 DevLoop's grab and quit (PS5_DevLoop/AGENTS.md, "Giving a title grab"). Once
+// every few frames the title tries to remove a request file in its own folder: removing it is the
+// check, one system call that fails on every ordinary launch. devloop-shot: this frame's picture,
+// with the options menu and overlays, becomes a new PNG in a folder that holds nothing else.
+// devloop-quit: a clean exit.
+void ps5DevLoop(unsigned int frame) {
+    static unsigned int grabs = 0;
+    if (frame % 4 != 0) {
+        return;
+    }
+    if (unlink("/app0/devloop-quit") == 0) {
+        writef(STDERR_FILENO, "[cos] ps5: devloop-quit\n");
+        pc_exit(PC_EXIT_REACHED);
+    }
+    if (unlink("/app0/devloop-shot") != 0) {
+        return;
+    }
+    const char* partial = "/app0/user/grab.partial";
+    mkdir("/app0/user/screenshots", 0777);
+    chmod("/app0/user", 0777);
+    chmod("/app0/user/screenshots", 0777);
+    {
+        std::lock_guard<std::mutex> lk(sDebugShotMu);
+        sDebugShotPath = partial;
+        sDebugShotOverlay = true;
+        sDebugShotAsked++;
+    }
+    debugShotFrameEnd(frame);
+    char name[64];
+    snprintf(name, sizeof(name), "/app0/user/screenshots/grab-%04u.png", grabs++);
+    chmod(partial, 0666);
+    if (rename(partial, name) != 0) {
+        writef(STDERR_FILENO, "[cos] ps5: grab: no picture written\n");
+    }
+}
+#endif
