diff --git a/CMakeLists.txt b/CMakeLists.txt
index 90b368d8291486f59b2774f26e70524290325d09..2a0306aa20758533dad7ee9ecc71de7d5cfc7487 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1329,6 +1329,31 @@ if(SDL_HAPTIC)
 endif()
 
 
+# The PlayStation 5 (the payload SDK's toolchain sets PS5): a FreeBSD-like
+# system for threads, time and files, with the console's own video, audio and
+# pad drivers, kept outside this tree in SDL_PS5_PORT_DIR.
+if(PS5)
+  if(NOT SDL_PS5_PORT_DIR OR NOT SDL_PS5_PLATFORM_DIR)
+    message(FATAL_ERROR "PS5: set SDL_PS5_PORT_DIR (the drivers) and SDL_PS5_PLATFORM_DIR (platform.h)")
+  endif()
+  sdl_include_directories(PRIVATE "${SDL_PS5_PLATFORM_DIR}")
+  if(SDL_AUDIO)
+    set(SDL_AUDIO_DRIVER_PS5 1)
+    sdl_sources("${SDL_PS5_PORT_DIR}/SDL_ps5audio.c")
+    set(HAVE_SDL_AUDIO TRUE)
+  endif()
+  if(SDL_JOYSTICK)
+    set(SDL_JOYSTICK_PS5 1)
+    sdl_sources("${SDL_PS5_PORT_DIR}/SDL_ps5joystick.c")
+    set(HAVE_SDL_JOYSTICK TRUE)
+  endif()
+  if(SDL_VIDEO)
+    set(SDL_VIDEO_DRIVER_PS5 1)
+    sdl_sources("${SDL_PS5_PORT_DIR}/SDL_ps5video.c")
+    set(HAVE_SDL_VIDEO TRUE)
+  endif()
+endif()
+
 # General SDL subsystem options, valid for all platforms
 if(SDL_AUDIO)
   # CheckDummyAudio/CheckDiskAudio - valid for all platforms
