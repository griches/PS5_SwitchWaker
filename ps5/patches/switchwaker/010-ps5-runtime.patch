+    if (read(fd, &head, sizeof(head)) == (ssize_t)sizeof(head) && memcmp(head.magic, "COSDIV1", 8) == 0 &&
+        head.count > 0 && head.count < 4000000) {
+        const size_t bytes = (size_t)head.count * sizeof(DivEntry);
+        DivEntry* table = static_cast<DivEntry*>(malloc(bytes));
+        size_t got = 0;
+        while (table != nullptr && got < bytes) {
+            const ssize_t n = read(fd, reinterpret_cast<char*>(table) + got, bytes - got);
+            if (n <= 0) {
+                break;
+            }
+            got += (size_t)n;
+        }
+        if (table != nullptr && got == bytes) {
+            sDivBase = reinterpret_cast<uintptr_t>(&pc_div_table_anchor) - (uintptr_t)head.anchor;
+            sDivCount = head.count;
+            sDivTable = table;
+        }
+    }
+    close(fd);
+    writef(STDERR_FILENO, "[cos] division table: %u instruction(s), load offset 0x%llx\n", sDivCount,
+           (unsigned long long)sDivBase);
+}
+
+void divFaultHandler(int sig, siginfo_t* info, void* context) {
+    (void)info;
+    ucontext_t* uc = static_cast<ucontext_t*>(context);
+    const uintptr_t rip = (uintptr_t)uc->uc_mcontext.mc_rip;
+    const uint64_t address = rip - sDivBase;
+    int length = 0, size = 0;
+    for (uint32_t lo = 0, hi = sDivCount; lo < hi;) {
+        const uint32_t mid = lo + (hi - lo) / 2;
+        if (sDivTable[mid].address == address) {
+            length = sDivTable[mid].length;
+            size = sDivTable[mid].size;
+            break;
+        }
+        if (sDivTable[mid].address < address) {
+            lo = mid + 1;
+        } else {
+            hi = mid;
+        }
+    }
+    if (length == 0) {
+        signal(sig, SIG_DFL); // not a listed division: it faults again, into the console's record
+        return;
+    }
+    static unsigned int sCount = 0;
+    if (sCount++ < 16) {
+        writef(STDERR_FILENO, "[cos] integer division fault at ELF address 0x%llx (%d-byte operand): quotient 0, going on\n",
+               (unsigned long long)address, size);
+    }
+    uint64_t& rax = reinterpret_cast<uint64_t&>(uc->uc_mcontext.mc_rax);
+    uint64_t& rdx = reinterpret_cast<uint64_t&>(uc->uc_mcontext.mc_rdx);
+    switch (size) {
+    case 1: rax = (rax & ~0xFFFFull) | ((rax & 0xFF) << 8); break; // AL = 0, AH = the dividend's low byte
+    case 2: rdx = (rdx & ~0xFFFFull) | (rax & 0xFFFF); rax &= ~0xFFFFull; break;
+    case 4: rdx = rax & 0xFFFFFFFFull; rax = 0; break;
+    default: rdx = rax; rax = 0; break;
+    }
+    uc->uc_mcontext.mc_rip += length;
+}
+#endif
