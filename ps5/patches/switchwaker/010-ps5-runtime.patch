+#elif defined(__PROSPERO__)
+    // PlayStation 5: no crash handler. The console writes a crash record of its own to klog
+    // (registers and a frame-pointer walk), which the port's ps5/tools/run.sh symbolises; a handler
+    // here would take the signal first and exit without one. SIGFPE alone is handled, to finish an
+    // integer division by zero as the other machines do (divFaultHandler).
+    {
+        loadDivTable();
+        struct sigaction sa = {};
+        sa.sa_sigaction = divFaultHandler;
+        sa.sa_flags = SA_SIGINFO;
+        sigemptyset(&sa.sa_mask);
+        sigaction(SIGFPE, &sa, nullptr);
+        const char* test = getenv("COS_DIV_TEST");
+        if (test != nullptr && atoi(test) > 0) {
+            volatile int a = 1234, b = 0;
+            volatile int q = a / b;
+            volatile int r = a % b;
+            writef(STDERR_FILENO, "[cos] div-test: 1234 / 0 = %d, 1234 %% 0 = %d\n", (int)q, (int)r);
+        }
+    }
 #else
     // Alternate signal stack for this (the main) thread, so a stack overflow still reports.
     static char sAltStack[256 * 1024];
