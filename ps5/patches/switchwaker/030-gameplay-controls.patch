+    const int scene = i_sceneReq->mReqPhsProcCls.id, node = i_sceneReq->mCrtReq.mReqPhsProc.id;
+    if (i_sceneReq != sReq || scene != sScene || node != sNode) {
+        sReq = i_sceneReq;
+        sScene = scene;
+        sNode = node;
+        sCalls = 0;
+        return;
+    }
+    if (++sCalls % 300 != 0) {
+        return;
+    }
+    fprintf(stderr, "[cos] scene-req-watch: %u calls in one step: fade %d, scene step %d, node step %d, proc %d, "
