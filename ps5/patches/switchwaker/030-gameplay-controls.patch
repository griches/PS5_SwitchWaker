+            node, (int)i_sceneReq->mCrtReq.mProcName, (int)g_fpcDtTg_Queue.mSize, (int)fopOvlpM_IsDoingReq(),
+            (int)fopOvlpM_IsDone());
+    int shown = 0;
+    for (node_class* n = g_fpcDtTg_Queue.mpHead; n != NULL && shown < 12; n = n->mpNextNode, shown++) {
+        delete_tag_class* tag = (delete_tag_class*)n;
+        base_process_class* proc = (base_process_class*)tag->base.mpTagData;
+        fprintf(stderr, "[cos] scene-req-watch:   deleting proc name %d id %u timer %d\n",
+                proc != NULL ? (int)proc->mProfName : -1, proc != NULL ? (unsigned)proc->mBsPcId : 0u,
+                (int)tag->mTimer);
+    }
+    fflush(stderr);
+}
+#endif
