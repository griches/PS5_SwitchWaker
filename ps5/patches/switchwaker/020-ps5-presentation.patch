+#if defined(__PROSPERO__)
+int pc_settings_restore_defaults(void) {
+    State& s = st();
+    computePath();
+    // Do not change live settings unless removing the saved configuration succeeds.
+    if (remove(s.path.c_str()) != 0 && errno != ENOENT) return -1;
+    for (const auto& line : s.devLines) {
+        std::string key, value;
+        if (devVariable(line, key, value) && !isLocked(key.c_str())) unsetenv(key.c_str());
+    }
+    for (const auto& key : s.fileSet) {
+        if (!isLocked(key.c_str())) unsetenv(key.c_str());
+    }
+    s.fileSet.clear();
+    for (auto& [key, entry] : s.entries) {
+        for (int slot = 0; slot < kSlots; ++slot) {
+            entry.stored[slot].clear();
+            entry.has[slot] = false;
+        }
+    }
+    s.hasDev = false;
+    s.devLines.clear();
+    s.migrationBlocked = false;
+    // Reapply even unchanged values: a reset must also repair stale live state.
+    // Keep bootValue intact so startup-only changes still report restart pending.
+    const auto keys = s.order;
+    for (const auto& key : keys) {
+        const std::string value = valueFor(key.c_str(), s.lastMode);
+        notify(s.entries[key], key.c_str(), value);
+    }
+    return 0;
+}
+#endif
