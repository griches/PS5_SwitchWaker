+#if defined(__PROSPERO__)
+// Only these upstream settings ever had a mode-specific PS5 player value.
+const char* const kPs5ProfileKeys[] = {"COS_FB_SCALE", "COS_DYNRES", "COS_HD_MAX_SIZE", "COS_FPS60"};
+
+bool sameFileContents(const std::string& left, const std::string& right) {
+    FILE* a = fopen(left.c_str(), "rb");
+    FILE* b = fopen(right.c_str(), "rb");
+    if (!a || !b) { if (a) fclose(a); if (b) fclose(b); return false; }
+    bool same = true;
+    char x[4096], y[4096];
+    for (;;) {
+        const size_t nx = fread(x, 1, sizeof(x), a), ny = fread(y, 1, sizeof(y), b);
+        if (nx != ny || memcmp(x, y, nx) != 0) { same = false; break; }
+        if (nx < sizeof(x)) { same = !ferror(a) && !ferror(b); break; }
+    }
+    fclose(a); fclose(b);
+    return same;
+}
+
+bool backupPs5Profile() {
+    const std::string base = st().path + ".pre-ps5-profile.bak";
+    // Reuse an identical backup on a retry. A newly copied legacy file gets its own backup.
+    for (unsigned int index = 0; index < 1000; ++index) {
+        const std::string path = base + (index ? "." + std::to_string(index) : "");
+        const int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0600);
+        if (fd < 0) {
+            if (errno != EEXIST) return false;
+            if (sameFileContents(st().path, path)) return true;
+            continue;
+        }
+        FILE* source = fopen(st().path.c_str(), "rb");
+        FILE* target = fdopen(fd, "wb");
+        bool ok = source && target;
+        if (ok) {
+            char data[4096];
+            size_t n;
+            while ((n = fread(data, 1, sizeof(data), source)) != 0) {
+                if (fwrite(data, 1, n, target) != n) { ok = false; break; }
+            }
+            ok = ok && !ferror(source);
+            if (fflush(target) != 0) ok = false;
+        }
+        if (source && fclose(source) != 0) ok = false;
+        if (target) { if (fclose(target) != 0) ok = false; }
+        else close(fd);
+        if (!ok) { remove(path.c_str()); return false; }
+        return true;
+    }
+    return false;
+}
+
+void migratePs5Profile() {
+    State& s = st();
+    const char* modeEnv = getenv("COS_OPERATION_MODE");
+    bool handheld = modeEnv && strcmp(modeEnv, "handheld") == 0;
+    bool changed = handheld;
+    if (auto it = s.entries.find("COS_OPERATION_MODE"); it != s.entries.end()) {
+        if (it->second.has[0]) handheld = it->second.stored[0] == "handheld";
+        s.entries.erase(it); changed = true;
+    }
+    // The old loader applied [dev] after its initial file values, and mode polling
+    // later adopted that override. Preserve that final active profile, not the editor selection.
+    std::vector<std::string> dev;
+    for (const auto& line : s.devLines) {
+        std::string key, value;
+        if (devVariable(line, key, value) && key == "COS_OPERATION_MODE") {
+            handheld = value == "handheld"; changed = true;
+        } else dev.push_back(line);
+    }
+    s.devLines = std::move(dev);
+    const int slot = handheld ? 1 + PC_MODE_HANDHELD : 1 + PC_MODE_DOCKED;
+    for (const char* key : kPs5ProfileKeys) {
+        Entry& e = s.entries[key];
+        changed = changed || e.has[1] || e.has[2];
+        if (e.has[slot]) { e.stored[0] = e.stored[slot]; e.has[0] = true; }
+        for (int i = 1; i < kSlots; ++i) { e.stored[i].clear(); e.has[i] = false; }
+        // Auto is PS5's fixed 1024 cap now; retain a legacy handheld's actual 512 cap.
+        if (handheld && strcmp(key, "COS_HD_MAX_SIZE") == 0 &&
+            (!e.has[0] || e.stored[0].empty() || e.stored[0] == "auto")) {
+            e.stored[0] = "512"; e.has[0] = true;
+        }
+    }
+    setenv("COS_OPERATION_MODE", "docked", 1);
+    if (!changed) return;
+    // The normalized in-memory values are safe even if persistence fails. Block
+    // later menu writes so they cannot accidentally discard unbacked legacy values.
+    if (!backupPs5Profile() || !writeFile()) {
+        s.migrationBlocked = true;
+        pc::writef(STDERR_FILENO, "[cos] settings: PS5 profile migration could not be saved; original retained, saves disabled until reload/restart\n");
+    } else {
+        pc::writef(STDERR_FILENO, "[cos] settings: migrated active %s profile; backup beside settings.ini\n", handheld ? "handheld" : "docked");
+    }
+}
